<?xml version="1.0" ?>
<!--
  maze.world - rectangular wall maze for the TurtleBot3 Burger (ROS 2 Humble)
  Generated by tools/generate_maze.py, 5x5 cells of 0.8 m,
  wall thickness 0.1 m, entrance at the south-west corner and exit at the
  north-east corner.
-->
<sdf version="1.6">
  <world name="maze_world">
    <!-- Sun light and ground plane are declared inline on purpose: referencing
         model://... makes Gazebo query the online model database
         (models.gazebosim.org) while loading the world, which hangs when the
         machine is offline or the mirror is unreachable. -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.90 0.92 0.96 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>2.00 2.00 6.0 0 1.5707 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- start pad (south-west corner, visual only) -->
    <model name="start_pad">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>0.0 0.85 0.2 1</ambient><diffuse>0.0 0.85 0.2 1</diffuse></material>
        </visual>
      </link>
      <pose>0.400 0.400 0 0 0 0</pose>
    </model>

    <!-- exit pad (north-east corner, visual only) -->
    <model name="exit_pad">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
      <pose>3.600 4.250 0 0 0 0</pose>
    </model>

    <model name="maze_wall_000_entrance_w">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.090 0.100 0.5</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
